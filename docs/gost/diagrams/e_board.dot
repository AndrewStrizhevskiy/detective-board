 e1 [label="Событие: «около часа ночи\nон был в доме»\nцитата → рассказ", fillcolor="#FFF4D6"]; e2 [label="Событие: «около часа ночи\nон был на пустоши»\nцитата → рассказ", fillcolor="#FFF4D6"];
