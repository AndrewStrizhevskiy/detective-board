digraph G { rankdir=TB; nodesep=0.3; ranksep=0.35; node [fontname="Arial", fontsize=15, shape=box, style="rounded,filled", fillcolor="#EEF1F5", color="#1F3A5F", margin="0.2,0.12"]; edge [color="#1F3A5F", penwidth=1.6, fontname="Arial", fontsize=12];
 q [label="Вы задаёте вопрос"];
 r [label="Диспетчер решает, какой это вопрос", shape=box];
